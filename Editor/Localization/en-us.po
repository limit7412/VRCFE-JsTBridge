# Common
msgid "common.ok"
msgstr "OK"

msgid "common.cancel"
msgstr "Cancel"

msgid "dialog.title"
msgstr "Kx VRC FE-JsT Bridge"

# Build warnings
msgid "warning.jerry_not_found"
msgstr "Jerry's Templates was not found"

msgid "warning.jerry_not_found:description"
msgstr "Nothing supplies the trigger parameter, so the generated bridge does nothing."

msgid "warning.jerry_not_found:hint"
msgstr "Add Jerry's Templates (MA version) to this avatar to make the bridge work. Ignore this warning if you plan to add it later."

msgid "warning.face_emo_not_found"
msgstr "FaceEmo was not found"

msgid "warning.face_emo_not_found:description"
msgstr "There is nothing to bypass, so the generated bridge does nothing."

msgid "warning.face_emo_not_found:hint"
msgstr "Add the FaceEmo output to this avatar to make the bridge work. Ignore this warning if you plan to add it later."

msgid "warning.face_emo_parameters_unresolved"
msgstr "Could not resolve FaceEmo's parameter names"

msgid "warning.face_emo_parameters_unresolved:description"
msgstr "FaceEmo's MA Parameters was not found, so the bridge was generated with the names as they are before renaming."

msgid "warning.face_emo_parameters_unresolved:hint"
msgstr "If FaceEmo is configured to prefix its parameters, the expression control method does nothing. Add FaceEmo's generated prefab to this avatar and build again."

msgid "warning.shared_blend_shapes"
msgstr "FaceEmo and face tracking write the same blend shapes"

msgid "warning.shared_blend_shapes:description"
msgstr "{0} blend shapes overlap ({1} and so on). With the expression control method FaceEmo keeps writing, so its default face cancels out the tracked values."

msgid "warning.shared_blend_shapes:hint"
msgstr "Register the blend shapes used by face tracking in FaceEmo's Excluded Blend Shapes."

msgid "warning.duplicate_component"
msgstr "Multiple Kx VRC FE-JsT Bridge components were found"

msgid "warning.duplicate_component:description"
msgstr "Only the settings on {0} are used and the others are ignored."

# Duplicate component guard
msgid "guard.log.duplicate"
msgstr "An avatar cannot have more than one Kx VRC FE-JsT Bridge. The duplicate component will be removed."

msgid "guard.dialog.duplicate_removed"
msgstr "An avatar can only have one Kx VRC FE-JsT Bridge, so the duplicate component was removed."

# Inspector
msgid "prop.control_method"
msgstr "Control Method"

msgid "prop.control_method.tooltip"
msgstr "Chooses how FaceEmo is kept from writing while face tracking is active."

msgid "prop.control_method.bypass"
msgstr "Bypass (legacy)"

msgid "prop.control_method.bypass.tooltip"
msgstr "Stops FaceEmo entirely through its bypass parameter. This is the method that predates expression control."

msgid "prop.control_method.expression_control"
msgstr "Expression control"

msgid "prop.control_method.expression_control.tooltip"
msgstr "Keeps FaceEmo running, and locks the expression, stops blinking, and switches to the chosen emote."

msgid "inspector.control_method.bypass"
msgstr "The method that predates expression control, kept for backward compatibility.\nFaceEmo stops writing, so the avatar's own expression layers surface again. Use FX Layers To Remove below to handle them."

msgid "inspector.control_method.expression_control"
msgstr "FaceEmo keeps writing, so the avatar's own expression layers stay covered as usual and the menu can still switch expressions while tracking.\nFaceEmo's default face writes the same blend shapes as face tracking, so register the tracking blend shapes in FaceEmo's Excluded Blend Shapes first."

msgid "prop.face_emote_index"
msgstr "Emote Number"

msgid "prop.face_emote_index.tooltip"
msgstr "Number of the emote to switch to while face tracking is active. It is the same number the FaceEmo expression select menu writes, counted from the top of the expression pattern as 0, 1, 2 and so on."

msgid "inspector.description"
msgstr "Keeps FaceEmo from writing facial expressions while face tracking is active.\nAdding this to the avatar root is recommended."

msgid "prop.bypass_trigger"
msgstr "Trigger"

msgid "prop.bypass_trigger.tooltip"
msgstr "Chooses which tracking state stops FaceEmo."

msgid "prop.bypass_trigger.facial_expressions_disabled"
msgstr "Eye or lip tracking is active"

msgid "prop.bypass_trigger.facial_expressions_disabled.tooltip"
msgstr "Follows FacialExpressionsDisabled of Jerry's Templates. Fires when either eye or lip tracking is active."

msgid "prop.bypass_trigger.lip_tracking_only"
msgstr "Only lip tracking is active (experimental)"

msgid "prop.bypass_trigger.lip_tracking_only.tooltip"
msgstr "Follows LipTrackingActive. FaceEmo keeps running while only eye tracking is active."

msgid "inspector.bypass_trigger.lip_tracking_only"
msgstr "This setting is experimental. With eye tracking only, FaceEmo's blink and default face still conflict with the eye blend shapes."

msgid "prop.enable_tracking_reapply"
msgstr "Re-apply Tracking Control"

msgid "prop.enable_tracking_reapply.tooltip"
msgstr "Generates the layer that re-applies Tracking Control to match the state of Jerry's Templates after FaceEmo applies its own."

msgid "inspector.tracking_reapply.disabled"
msgstr "Without the re-apply layer, lip sync comes back and the eyes freeze while only lip tracking is active. Turn this off only to work around trouble."

msgid "prop.reapply_delay_seconds"
msgstr "Re-apply Delay (seconds)"

msgid "prop.reapply_delay_seconds.tooltip"
msgstr "Seconds to wait for FaceEmo to apply its own Tracking Control. Increase it when Tracking Control does not follow."

# FX layer removal
msgid "prop.remove_fx_layers"
msgstr "FX Layers To Remove"

msgid "prop.remove_fx_layers.tooltip"
msgstr "Names of the FX layers removed at build time. The avatar's own assets are not modified."

msgid "inspector.remove_fx_layers"
msgstr "With the bypass method FaceEmo stops writing, and the avatar's own expression layers surface again.\nList those layers here (gesture expressions, blink, Tracking Control switching, and so on) and they are removed from FX at build time.\nOpen the built FX in the Animator window to find the layer names."

msgid "warning.fx_not_found"
msgstr "The FX controller was not found"

msgid "warning.fx_not_found:description"
msgstr "FX layers to remove are listed, but the avatar has no FX controller."

msgid "warning.layer_not_found"
msgstr "An FX layer was not found"

msgid "warning.layer_not_found:description"
msgstr "FX has no layer named {0}, so nothing was removed for it. Check the name."

msgid "warning.layer_not_found:hint"
msgstr "Layers merged later by Merge Animator are out of scope. Only layers in the avatar's own FX can be removed."

msgid "warning.synced_layer_detached"
msgstr "A synced layer lost its source"

msgid "warning.synced_layer_detached:description"
msgstr "The layer {0} referenced was removed, so the reference was cleared."

msgid "info.layers_removed"
msgstr "FX layers were removed"

msgid "info.layers_removed:description"
msgstr "{0}"

# Safeguards for FX layer removal
msgid "warning.fx_not_editable"
msgstr "The FX controller cannot be edited"

msgid "warning.fx_not_editable:description"
msgstr "FX is still a project asset, so the layer removal was skipped. This keeps the avatar's own asset intact."

msgid "warning.fx_not_editable:hint"
msgstr "Modular Avatar clones the controllers during the build, so this warning does not normally appear."

msgid "warning.layer_control_detached"
msgstr "A layer control lost its target"

msgid "warning.layer_control_detached:description"
msgstr "A VRC Animator Layer Control in {0} pointed at a removed FX layer. Its target was cleared so that it does not drive a different layer."

msgid "warning.layer_control_not_editable"
msgstr "Layer control indices cannot be remapped"

msgid "warning.layer_control_not_editable:description"
msgstr "{0} is still a project asset, so its VRC Animator Layer Control indices could not be remapped. Controls pointing after a removed layer now drive a different layer."

# Finding layers to remove
msgid "inspector.inspect.button"
msgstr "Find layers to remove"

msgid "inspector.inspect.multi_edit"
msgstr "Inspection is unavailable while multiple components are selected. Each avatar has its own FX, so select a single component before inspecting."

msgid "inspector.inspect.no_fx"
msgstr "The avatar has no FX controller. Check that FX is set to something other than Default."

msgid "inspector.inspect.no_reference"
msgstr "FaceEmo and Jerry's Templates were not found, so there is nothing to compare against. Layers that write blend shapes are listed as they are, so check each one before adding it."

msgid "inspector.inspect.empty_reference"
msgstr "FaceEmo or Jerry's Templates was found, but none of its clips write blend shapes. There is nothing to compare against, so blend shapes were not used for judging. Check that the expression clips are set up."

msgid "inspector.inspect.write_defaults"
msgstr "Layers outside this list have states with Write Defaults on. Such states also reset blend shapes their clips do not write, so a layer missing from this list can still break expressions during bypass."

msgid "inspector.inspect.no_face_emo"
msgstr "FaceEmo was not found. Its blend shapes are missing from the comparison, so layers that only conflict with FaceEmo are shown as having no conflict."

msgid "inspector.inspect.no_jerry"
msgstr "Jerry's Templates was not found. Tracking blend shapes are missing from the comparison, so layers that only conflict with tracking are shown as having no conflict."

msgid "inspector.inspect.no_candidate"
msgstr "No layer looks like it conflicts."

msgid "inspector.inspect.candidates"
msgstr "Layers to remove"

msgid "inspector.inspect.others"
msgstr "Other layers ({0})"

msgid "inspector.inspect.layer"
msgstr "{0} (layer {1})"

msgid "inspector.inspect.layer_index"
msgstr "Layer {0}"

msgid "inspector.inspect.same_name"
msgstr "{0} other layers share this name (layer {1}). Removal works by name, so adding it removes those too."

msgid "inspector.inspect.empty_name"
msgstr "This layer has no name. Removal works by name, so it cannot be targeted. Name the layer in the Animator window and inspect again."

msgid "inspector.inspect.add"
msgstr "Add"

msgid "inspector.inspect.add_all"
msgstr "Add every candidate"

msgid "inspector.inspect.reason.shared"
msgstr "Writes {0} blend shapes that expressions or tracking also write: {1}"

msgid "inspector.inspect.reason.blend_shapes"
msgstr "Writes {0} blend shapes: {1}"

msgid "inspector.inspect.reason.tracking_control"
msgstr "Switches Tracking Control for eyes or mouth"

msgid "inspector.inspect.verdict.no_conflict"
msgstr "No conflict"

# Update check
msgid "update.available.vpm"
msgstr "Version {0} is available.\nUpdate through VCC/ALCOM."

msgid "update.available.booth"
msgstr "Version {0} is available.\nDownload it from Releases, then delete the existing folder under Assets and import it again."

msgid "update.available.unknown"
msgstr "Version {0} is available."

msgid "update.open_releases"
msgstr "Open Releases"

msgid "update.dismiss"
msgstr "Skip this version"

msgid "update.settings.enabled"
msgstr "Check for updates"

msgid "update.settings.description"
msgstr "Queries GitHub Releases at most once a day and shows a notice in the inspector when a newer version is available.\nThis is on by default. Turning it off stops the request."

msgid "update.available.booth_updatable"
msgstr "Version {0} is available.\nYou can update from here."

msgid "update.run"
msgstr "Update"

msgid "update.confirm"
msgstr "Update to version {0}.\nThe contents of {1} will be replaced and this cannot be undone. Back up your own changes to that folder first."

msgid "update.announce.message"
msgstr "Version {0} is available.\nUpdate now?\n\nThe contents of Assets/AtelierKairox/VRCFE-JsTBridge will be replaced and this cannot be undone."

msgid "update.announce.update"
msgstr "Update"

msgid "update.announce.later"
msgstr "Later"

msgid "update.completed"
msgstr "Updated to version {0}."

msgid "update.incomplete"
msgstr "The update to version {0} did not finish. The previous contents are kept at {1}."

msgid "update.error.unsupported"
msgstr "This project cannot be updated automatically. Download the latest version from Releases and import it again."

msgid "update.error.release_missing"
msgstr "Could not fetch the release for version {0}."

msgid "update.error.asset_missing"
msgstr "The release has no {0} attached."

msgid "update.error.download"
msgstr "Download failed: {0}"

msgid "update.error.digest"
msgstr "The downloaded file does not match the digest reported by GitHub. The update was stopped."

msgid "update.error.archive"
msgstr "Could not read the downloaded file: {0}"

msgid "update.error.contents"
msgstr "Stopped because the downloaded package does not contain what was expected."

msgid "update.error.version"
msgstr "Stopped because the published package is not version {0}."

msgid "update.error.scan"
msgstr "Stopped because the installed files could not be inspected: {0}"

msgid "update.error.import"
msgstr "The import failed: {0}\nThe previous contents are kept at {1}."

msgid "update.error.import_cancelled"
msgstr "The import was cancelled.\nThe previous contents are kept at {0}."

msgid "update.error.backup"
msgstr "Stopped because the previous contents could not be backed up: {0}"

msgid "update.error.delete"
msgstr "Stopped before importing because old files could not be deleted.\nCould not delete: {0}\nThe previous contents are kept at {1}."

msgid "update.error.playing"
msgstr "Cannot update while in play mode. Exit play mode and try again."

# Extra parameters
msgid "prop.extra_parameters"
msgstr "Extra Parameters"

msgid "prop.extra_parameters.tooltip"
msgstr "Parameters to set only while face tracking is active, such as toggles made with Modular Avatar."

msgid "inspector.extra_parameters"
msgstr "Each value is written when face tracking is turned on, and handled as set in On Release when it is turned off.\nSynced parameters are written only once at each switch, so you can still change them from the menu while face tracking is active.\nParameters that are not synced are written on every client, and rewritten about every second while face tracking is active."

msgid "prop.extra_parameter.source"
msgstr "Source"

msgid "prop.extra_parameter.source.menu_item"
msgstr "MA Menu Item"

msgid "prop.extra_parameter.source.parameter_name"
msgstr "Parameter Name"

msgid "prop.extra_parameter.menu_item"
msgstr "Menu Item"

msgid "prop.extra_parameter.menu_item.tooltip"
msgstr "An MA Menu Item of the toggle or button type. Its parameter name and toggle value are read at build time."

msgid "prop.extra_parameter.menu_item_state"
msgstr "State While Tracking"

msgid "prop.extra_parameter.state.on"
msgstr "On"

msgid "prop.extra_parameter.state.off"
msgstr "Off"

msgid "prop.extra_parameter.parameter_name"
msgstr "Parameter Name"

msgid "prop.extra_parameter.parameter_name.tooltip"
msgstr "The name used in the FX layer, after Modular Avatar renames it."

msgid "prop.extra_parameter.parameter_type"
msgstr "Type"

msgid "prop.extra_parameter.engaged_value"
msgstr "Value While Tracking"

msgid "prop.extra_parameter.release_mode"
msgstr "On Release"

msgid "prop.extra_parameter.release_mode.revert"
msgstr "Write Release Value"

msgid "prop.extra_parameter.release_mode.keep"
msgstr "Do Nothing"

msgid "prop.extra_parameter.released_value"
msgstr "Release Value"

msgid "prop.extra_parameter.release_mode.restore"
msgstr "Restore Previous Value"

msgid "prop.extra_parameter.sync_mode"
msgstr "Sync"

msgid "prop.extra_parameter.sync_mode.tooltip"
msgstr "Synced parameters are written only on the wearer's client. Parameters that are not synced are written on every client."

msgid "prop.extra_parameter.sync_mode.auto"
msgstr "Auto"

msgid "prop.extra_parameter.sync_mode.synced"
msgstr "Synced"

msgid "prop.extra_parameter.sync_mode.unsynced"
msgstr "Not Synced"

msgid "inspector.extra_parameter.menu_item_revert"
msgstr "With Write Release Value, the menu item is switched to the opposite of its state while tracking."

msgid "warning.extra_parameter.empty_name"
msgstr "An extra parameter has no name"

msgid "warning.extra_parameter.empty_name:description"
msgstr "Entry {0} was skipped because its parameter name is empty."

msgid "warning.extra_parameter.empty_name:hint"
msgstr "Enter a parameter name, or remove the entry if you do not need it."

msgid "warning.extra_parameter.missing_menu_item"
msgstr "An extra parameter has no menu item"

msgid "warning.extra_parameter.missing_menu_item:description"
msgstr "Entry {0} was skipped because no menu item is set."

msgid "warning.extra_parameter.missing_menu_item:hint"
msgstr "Set a menu item, or remove the entry if you do not need it."

msgid "warning.extra_parameter.outside_avatar"
msgstr "An extra parameter refers to a menu item outside the avatar"

msgid "warning.extra_parameter.outside_avatar:description"
msgstr "Entry {0} was skipped because {1} is not part of the avatar being built."

msgid "warning.extra_parameter.outside_avatar:hint"
msgstr "Set a menu item inside this avatar."

msgid "warning.extra_parameter.unsupported_control"
msgstr "An extra parameter refers to a menu item that is neither a toggle nor a button"

msgid "warning.extra_parameter.unsupported_control:description"
msgstr "Entry {0} was skipped because {1} has no single value for on and off."

msgid "warning.extra_parameter.unsupported_control:hint"
msgstr "Set a toggle or button menu item, or specify the parameter by name."

msgid "warning.extra_parameter.unnamed_parameter"
msgstr "An extra parameter refers to a menu item without a parameter name"

msgid "warning.extra_parameter.unnamed_parameter:description"
msgstr "Entry {0} was skipped because {1} has no parameter name. Modular Avatar assigns a name during the build, so the target cannot be determined."

msgid "warning.extra_parameter.unnamed_parameter:hint"
msgstr "Enter a parameter name on the menu item."

msgid "warning.extra_parameter.reserved_name"
msgstr "An extra parameter uses a name reserved by the bridge"

msgid "warning.extra_parameter.reserved_name:description"
msgstr "Entry {0} was skipped because its parameter name starts with FEJsTBridge/Stash/. The bridge uses these names to store previous values."

msgid "warning.extra_parameter.reserved_name:hint"
msgstr "Specify a parameter whose name does not start with FEJsTBridge/Stash/."

msgid "warning.extra_parameter.duplicate_name"
msgstr "Extra parameters write to the same parameter"

msgid "warning.extra_parameter.duplicate_name:description"
msgstr "Entry {0} was skipped because an earlier entry writes to the same parameter."

msgid "warning.extra_parameter.duplicate_name:hint"
msgstr "Keep only one entry for each parameter."

msgid "warning.extra_parameter.automatic_value"
msgstr "The value of an extra parameter's menu item cannot be determined"

msgid "warning.extra_parameter.automatic_value:description"
msgstr "Entry {0} was skipped because {1} uses an automatic value and other menu items share its parameter. The value Modular Avatar assigns during the build cannot be determined."

msgid "warning.extra_parameter.automatic_value:hint"
msgstr "Turn off the automatic value on the menu item and enter a value."
