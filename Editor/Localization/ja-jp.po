msgstr ""
"Language: ja-jp\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

# 共通
msgid "common.ok"
msgstr "OK"

msgid "dialog.title"
msgstr "Kx VRC FE-JsT Bridge"

# ビルド時の警告
msgid "warning.jerry_not_found"
msgstr "Jerry's Templatesが見つかりません"

msgid "warning.jerry_not_found:description"
msgstr "トリガーとなるパラメータの供給元がないため、生成したブリッジは何もしません。"

msgid "warning.jerry_not_found:hint"
msgstr "Jerry's Templates (MA版) をこのアバターへ追加すると動作します。あとから追加する予定であれば、この警告は無視して構いません。"

msgid "warning.face_emo_not_found"
msgstr "FaceEmoが見つかりません"

msgid "warning.face_emo_not_found:description"
msgstr "バイパスさせる相手がいないため、生成したブリッジは何もしません。"

msgid "warning.face_emo_not_found:hint"
msgstr "FaceEmoの生成物をこのアバターへ追加すると動作します。あとから追加する予定であれば、この警告は無視して構いません。"

msgid "warning.duplicate_component"
msgstr "Kx VRC FE-JsT Bridgeが複数あります"

msgid "warning.duplicate_component:description"
msgstr "{0}の設定だけを使い、残りは無視しました。"

# 重複コンポーネントの自動排除
msgid "guard.log.duplicate"
msgstr "1つのアバターにKx VRC FE-JsT Bridgeを複数追加できません。重複しているコンポーネントを削除します。"

msgid "guard.dialog.duplicate_removed"
msgstr "1つのアバターにKx VRC FE-JsT Bridgeは1つだけ置けるため、重複していたコンポーネントを削除しました。"

# インスペクタ
msgid "inspector.description"
msgstr "フェイストラッキングが有効な間、FaceEmoを自動でバイパスさせます。\nアバタールートへの追加を推奨します。"

msgid "prop.bypass_trigger"
msgstr "バイパスの発動条件"

msgid "prop.bypass_trigger.tooltip"
msgstr "どのトラッキング状態でFaceEmoを止めるかを選びます。"

msgid "prop.bypass_trigger.facial_expressions_disabled"
msgstr "目か口が有効なとき"

msgid "prop.bypass_trigger.facial_expressions_disabled.tooltip"
msgstr "Jerry's TemplatesのFacialExpressionsDisabledに従います。目と口のどちらかが有効なら発動します。"

msgid "prop.bypass_trigger.lip_tracking_only"
msgstr "口が有効なときだけ (実験的)"

msgid "prop.bypass_trigger.lip_tracking_only.tooltip"
msgstr "LipTrackingActiveに従います。目だけのトラッキングではFaceEmoを止めません。"

msgid "inspector.bypass_trigger.lip_tracking_only"
msgstr "実験的な設定です。目だけをトラッキングする構成では、FaceEmoのまばたきとデフォルト表情が目のシェイプと競合したままになります。"

msgid "prop.enable_tracking_reapply"
msgstr "Tracking Controlを再適用する"

msgid "prop.enable_tracking_reapply.tooltip"
msgstr "バイパスの成立後に、Tracking ControlをJerry's Templatesの状態へ合わせ直すレイヤーを生成します。"

msgid "inspector.tracking_reapply.disabled"
msgstr "再適用を止めると、リップシンクが復活する、目だけトラッキング時に目が固まる、といった競合が起きます。トラブルシュートのときだけ無効にしてください。"

msgid "prop.reapply_delay_seconds"
msgstr "再適用までの待ち時間 (秒)"

msgid "prop.reapply_delay_seconds.tooltip"
msgstr "バイパスの成立を待つ秒数です。Tracking Controlが追従しないときは値を増やしてください。"

# FXレイヤーの除去
msgid "prop.remove_fx_layers"
msgstr "取り除くFXレイヤー"

msgid "prop.remove_fx_layers.tooltip"
msgstr "ビルド時にFXから取り除くレイヤーの名前です。アバター素体のアセットは書き換わりません。"

msgid "inspector.remove_fx_layers"
msgstr "FaceEmoをバイパスすると、FaceEmoが書き込みを止めた分だけ、素体の表情レイヤーが表に出てきます。\n素体の表情レイヤー (ジェスチャー表情、まばたき、Tracking Controlの切り替えなど) の名前をここに並べると、ビルド時にFXから取り除きます。\nレイヤー名はビルド後のFXをAnimatorウィンドウで開くと確認できます。"

msgid "warning.fx_not_found"
msgstr "FXコントローラが見つかりません"

msgid "warning.fx_not_found:description"
msgstr "取り除くFXレイヤーが指定されていますが、アバターにFXコントローラがありません。"

msgid "warning.layer_not_found"
msgstr "FXレイヤーが見つかりません"

msgid "warning.layer_not_found:description"
msgstr "{0}という名前のレイヤーがFXにないため、取り除けませんでした。名前を確認してください。"

msgid "warning.layer_not_found:hint"
msgstr "Merge Animatorであとからマージされるレイヤーは対象外です。取り除けるのは素体のFXにあるレイヤーだけです。"

msgid "warning.synced_layer_detached"
msgstr "Syncedレイヤーの参照先が無くなりました"

msgid "warning.synced_layer_detached:description"
msgstr "{0}が参照していたレイヤーを取り除いたため、参照を外しました。"

msgid "info.layers_removed"
msgstr "FXレイヤーを取り除きました"

msgid "info.layers_removed:description"
msgstr "{0}"

# FXレイヤー除去の安全側の処理
msgid "warning.fx_not_editable"
msgstr "FXコントローラを書き換えられません"

msgid "warning.fx_not_editable:description"
msgstr "FXがプロジェクトのアセットのままのため、レイヤーの除去を見送りました。素体のアセットを壊さないための処置です。"

msgid "warning.fx_not_editable:hint"
msgstr "Modular Avatarがビルド中にコントローラを複製するため、通常はこの警告は出ません。"

msgid "warning.layer_control_detached"
msgstr "レイヤー操作の参照先が無くなりました"

msgid "warning.layer_control_detached:description"
msgstr "{0}にあるVRC Animator Layer Controlが、除去したFXレイヤーを指していました。誤って別のレイヤーを操作しないよう、参照を無効にしました。"

msgid "warning.layer_control_not_editable"
msgstr "レイヤー操作の索引を付け替えられません"

msgid "warning.layer_control_not_editable:description"
msgstr "{0}がプロジェクトのアセットのままのため、VRC Animator Layer Controlの索引を付け替えられませんでした。除去したレイヤーより後ろを指す操作が、別のレイヤーへずれます。"

# 除去候補の調査
msgid "inspector.inspect.button"
msgstr "除去候補を調べる"

msgid "inspector.inspect.multi_edit"
msgstr "複数のコンポーネントを選択している間は、除去候補を調べられません。アバターごとにFXが異なるため、一つだけ選択してから調べてください。"

msgid "inspector.inspect.no_fx"
msgstr "アバターのFXコントローラが見つかりません。FXにDefault以外のコントローラが割り当てられているか確認してください。"

msgid "inspector.inspect.no_reference"
msgstr "FaceEmoとJerry's Templatesが見つからないため、比較の基準がありません。ブレンドシェイプを書くレイヤーをそのまま挙げているので、内容を確認してから追加してください。"

msgid "inspector.inspect.empty_reference"
msgstr "FaceEmoかJerry's Templatesは見つかりましたが、ブレンドシェイプを書くクリップがありません。比較の土台が無いため、ブレンドシェイプによる判定はしていません。表情のクリップが設定されているか確認してください。"

msgid "inspector.inspect.write_defaults"
msgstr "候補以外のレイヤーにWrite Defaultsが有効なステートがあります。有効なステートはクリップに書いていないブレンドシェイプも既定値へ戻すため、この一覧に出ないレイヤーがバイパス中に表情を崩すことがあります。"

msgid "inspector.inspect.no_face_emo"
msgstr "FaceEmoが見つかりません。FaceEmoが書くブレンドシェイプを基準に入れられないため、FaceEmoとだけ競合するレイヤーは「競合なし」と出ます。"

msgid "inspector.inspect.no_jerry"
msgstr "Jerry's Templatesが見つかりません。トラッキングが書くブレンドシェイプを基準に入れられないため、トラッキングとだけ競合するレイヤーは「競合なし」と出ます。"

msgid "inspector.inspect.no_candidate"
msgstr "競合しそうなレイヤーは見つかりませんでした。"

msgid "inspector.inspect.candidates"
msgstr "除去候補"

msgid "inspector.inspect.others"
msgstr "候補以外のレイヤー ({0})"

msgid "inspector.inspect.layer"
msgstr "{0} (レイヤー {1})"

msgid "inspector.inspect.layer_index"
msgstr "レイヤー {0}"

msgid "inspector.inspect.same_name"
msgstr "同じ名前のレイヤーが他に{0}枚あります (レイヤー {1})。除去は名前で行うため、追加するとそれらもまとめて消えます。"

msgid "inspector.inspect.empty_name"
msgstr "このレイヤーには名前がありません。除去は名前で行うため指定できません。Animatorでレイヤーに名前を付けてから、もう一度調べてください。"

msgid "inspector.inspect.add"
msgstr "追加"

msgid "inspector.inspect.add_all"
msgstr "候補をすべて追加"

msgid "inspector.inspect.reason.shared"
msgstr "表情やトラッキングと同じブレンドシェイプを{0}個書く: {1}"

msgid "inspector.inspect.reason.blend_shapes"
msgstr "ブレンドシェイプを{0}個書く: {1}"

msgid "inspector.inspect.reason.tracking_control"
msgstr "Tracking ControlでEyesかMouthを切り替える"

msgid "inspector.inspect.verdict.no_conflict"
msgstr "競合なし"

msgid "inspector.inspect.verdict.managed"
msgstr "他のツールが管理"

# 更新の確認
msgid "update.consent.description"
msgstr "新しいバージョンが出ているかをGitHubのReleasesへ問い合わせますか？\n確認は1日1回までで、送るのはリリース情報の取得要求だけです。この設定は Preferences > Kx VRC FE-JsT Bridge から変更できます。"

msgid "update.consent.enable"
msgstr "確認する"

msgid "update.consent.disable"
msgstr "確認しない"

msgid "update.available"
msgstr "新しいバージョン {0} が公開されています。\nVCC/ALCOM経由で入れた場合はVCC/ALCOMから、zipから手で入れた場合はReleasesの新しいzipで入れ直してください。"

msgid "update.open_releases"
msgstr "Releasesを開く"

msgid "update.dismiss"
msgstr "このバージョンは通知しない"

msgid "update.settings.enabled"
msgstr "更新を確認する"

msgid "update.settings.description"
msgstr "GitHubのReleasesへ1日1回まで問い合わせ、新しいバージョンが出ていればインスペクタに知らせます。"
